{
  "name": "statusvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "prisma generate && tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node scripts/start.mjs",
    "test": "node tests/integration.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "1.2.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "file-type": "21.3.4",
    "framer-motion": "11.15.0",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "pino": "9.7.0",
    "prisma": "6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "esbuild": "0.25.1",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vite": "6.4.6"
  }
}
